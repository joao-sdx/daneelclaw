#
# ======================================================================================================================
# vaadin https://vaadin.com/docs/latest/configuration/source-control
# ======================================================================================================================

!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/
package.json
package-lock.json
vite.config.ts
.DS_Store
bundles

# The following files are generated/updated by vaadin-maven-plugin or vaadin-gradle-plugin
node_modules/
frontend/generated/
pnpmfile.js
.npmrc
webpack.generated.js
vite.generated.ts

# Browser drivers for local integration tests
drivers/

# Error screenshots generated by TestBench for failed integration tests
error-screenshots/


# The following are auto-generated by Vaadin if missing, but they should be added to source control if customized.
tsconfig.json
types.d.ts
index.html

# Allow static chat frontend files
!src/main/resources/static/index.html
!src/main/resources/static/chat.js

