# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.
# Usage: start.sh sources .env automatically before launching the app.

# LMStudio model to use (must be loaded in LMStudio before starting)
LMSTUDIO_MODEL=nvidia/nemotron-3-nano-4b

# Telegram bot — leave disabled if not using the Telegram channel
# 1. Create a bot via @BotFather and copy the token below
# 2. Get your chat ID via @userinfobot
# 3. Set TELEGRAM_ENABLED=true to activate the inbound route
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# DataForSEO — required for seo_search and seo_fetch_article tools
# Create an account at https://dataforseo.com and find credentials in your dashboard
DATAFORSEO_USER=
DATAFORSEO_KEY=

# YetiForce CRM — required for yetiforce_* tools (Leads, Accounts, Contacts, SalesProcesses)
# Two credential layers — see CRM > Settings > Integration > Web service:
#   Application layer (Basic auth + API key): Administration → Web service / Applications
#   User layer (login credentials):           Administration → Web service / Users
WS_URL=                  # base URL, e.g. https://crm.example.com  (also set as YETIFORCE_URL)
WS_APP_NAME=             # application name  (Basic auth username)
WS_APP_PASS=             # application password  (Basic auth password)
WS_API_KEY=              # application API key  (X-API-KEY header)
WS_USER=                 # web service user login
WS_PASS=                 # web service user password

# Aliases used by the Java app (YetiForceProperties) and Taskfile — keep in sync with WS_* above
YETIFORCE_URL=${WS_URL}
YETIFORCE_API_KEY=${WS_API_KEY}
YETIFORCE_APP_NAME=${WS_APP_NAME}
YETIFORCE_APP_PASS=${WS_APP_PASS}
YETIFORCE_USER=${WS_USER}
YETIFORCE_PASSWORD=${WS_PASS}
