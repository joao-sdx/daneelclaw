# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.
# Usage: start.sh sources .env automatically before launching the app.

# LMStudio model to use (must be loaded in LMStudio before starting)
LMSTUDIO_MODEL=nvidia/nemotron-3-nano-4b

# Telegram bot — leave disabled if not using the Telegram channel
# 1. Create a bot via @BotFather and copy the token below
# 2. Get your chat ID via @userinfobot
# 3. Set TELEGRAM_ENABLED=true to activate the inbound route
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# DataForSEO — required for seo_search and seo_fetch_article tools
# Create an account at https://dataforseo.com and find credentials in your dashboard
DATAFORSEO_USER=
DATAFORSEO_KEY=

# YetiForce CRM — required for yetiforce_* tools (Leads, Accounts, Contacts, SalesProcesses)
# 1. Set YETIFORCE_URL to your instance base URL (e.g. https://crm.example.com)
# 2. Create an API key in Administration → Integration → Web service - Applications
# 3. Create a WebserviceStandard user in Administration → Integration → Web service - Users
YETIFORCE_URL=
YETIFORCE_API_KEY=
YETIFORCE_USER=
YETIFORCE_PASSWORD=
